# Server Configuration
NODE_ENV=development
PORT=8080
TRUST_PROXY=true
# '*' o lista separada por comas. Sin definir: '*' en desarrollo y las consolas conocidas en producción.
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Authentication & Security
JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRES_IN=8h

# Intechsys One Platform (IAM Centralizado & Multi-tenant)
ONE_BASE_URL=https://app-intechsysone-api-prd-bxehhkf8dgcwbve9.centralus-01.azurewebsites.net
ONE_APP_SLUG=zero-touch
ONE_TIMEOUT_MS=15000

# SQL Server Database
# Sin estas variables se usa la base de producción (Azure SQL, sql-zerotouch-prd-01 / ZeroTouch).
# Para desarrollo local con docker compose (servicio "sqlserver"):
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ZeroTouch
DB_USER=sa
DB_PASSWORD=ZeroTouch_Local_2026!
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
# O todo en una cadena (tiene prioridad sobre las anteriores):
# DB_CONNECTION_STRING=Server=localhost,1433;Database=ZeroTouch;User Id=sa;Password=...;Encrypt=true;TrustServerCertificate=true

# Android Zero-touch Provisioning
ZERO_TOUCH_BASE_URL=https://androiddeviceprovisioning.googleapis.com/v1
ZERO_TOUCH_PARTNER_ID=your_partner_id
DEMO_ZERO_TOUCH_CUSTOMER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Samsung Knox Cloud Services (Optional)
SAMSUNG_KNOX_ENABLED=false
SAMSUNG_KNOX_BASE_URL=https://us-kcs-api.samsungknox.com
SAMSUNG_KNOX_OAUTH_TOKEN_URL=https://api.samsungknox.com/ams/v1/oauth2/token
SAMSUNG_KNOX_AUTH_MODE=auto
SAMSUNG_KNOX_OAUTH_SCOPE=
SAMSUNG_KNOX_API_TOKEN=
SAMSUNG_KNOX_CLIENT_ID=
SAMSUNG_KNOX_CLIENT_SECRET=
SAMSUNG_KNOX_ACCESS_TOKEN=
SAMSUNG_KNOX_CLIENT_IDENTIFIER=
SAMSUNG_KNOX_KEYS_JSON=
SAMSUNG_KNOX_KEYS_PATH=
SAMSUNG_KNOX_RESELLER_EMAIL=
SAMSUNG_KNOX_ALLOWED_LOGIN_EMAILS=
SAMSUNG_KNOX_ALLOWED_CUSTOMER_IDS=

